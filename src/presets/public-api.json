{
  "version": 1,
  "name": "Rate-limited public API",
  "description": "A public JSON API behind a real API gateway: it verifies a token on every call (authLatencyMs) and admits at most rateLimitRps. Past the limit the excess comes back 429 — the app tier and DB never see it.",
  "notes": "Push traffic well above the gateway's rateLimitRps: the API servers and DB stay green while success collapses at the edge — that's the gateway shielding them. Then raise rateLimitRps and watch the load move downstream onto the app tier and Postgres.",
  "nodes": [
    { "id": "clients", "type": "client", "position": { "x": 320, "y": 0 }, "label": "API clients", "params": {} },
    { "id": "gw", "type": "apiGateway", "position": { "x": 320, "y": 150 }, "label": "API gateway", "params": { "capacityRps": 30000, "instances": 2, "authLatencyMs": 3, "rateLimitRps": 2000, "authErrorRate": 0.001 } },
    { "id": "api", "type": "apiServer", "position": { "x": 320, "y": 300 }, "label": "api-svc", "params": { "serviceTimeMs": 25, "vcpus": 4, "ramGB": 8, "replicas": 3 } },
    { "id": "cache", "type": "cache", "position": { "x": 120, "y": 450 }, "label": "response cache", "params": { "hitRatio": 0.6, "hitLatencyMs": 1 } },
    { "id": "db", "type": "sqlDatabase", "position": { "x": 320, "y": 590 }, "label": "Postgres", "params": { "architecture": "primary-replica", "queryTimeMs": 7, "poolSize": 25, "readReplicas": 1, "readRatio": 0.85 } }
  ],
  "edges": [
    { "id": "e1", "source": "clients", "target": "gw", "params": {} },
    { "id": "e2", "source": "gw", "target": "api", "params": {} },
    { "id": "e3", "source": "api", "target": "cache", "params": {} },
    { "id": "e4", "source": "cache", "target": "db", "params": { "retries": 1 } }
  ],
  "sim": {
    "scenario": { "kind": "spike", "mode": "users", "targetRps": 1500, "users": 1500, "thinkTimeSec": 1, "durationSec": 120, "peakFactor": 6 },
    "seed": 1,
    "speed": 4
  }
}
